# Em produção, use postgresql://usuario:senha@host:5432/banco
# Sem DATABASE_URL, a aplicação cria data/rdv.db automaticamente.
DATABASE_URL=

ADMIN_USERNAME=admin
# Gere com:
# python -c "import bcrypt; print(bcrypt.hashpw(b'SUA_SENHA', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$SUBSTITUA_PELO_HASH_GERADO

# Usuários do fluxo de aprovação. Se os hashes abaixo ficarem vazios, ambos
# usam temporariamente ADMIN_PASSWORD_HASH (mantendo compatibilidade).
ANALYST_USERNAME=analista
ANALYST_PASSWORD_HASH=
MANAGER_USERNAME=gestor
MANAGER_PASSWORD_HASH=
